# Copy this file to .env and fill in real values. Never commit .env!

# --- Datenbank ---
# Entwicklung (SQLite, Datei liegt im backend/-Ordner):
DATABASE_URL=sqlite:///./moodly.db
# Produktion (PostgreSQL):
# DATABASE_URL=postgresql+psycopg://user:passwort@host:5432/journal

# --- Sicherheit ---
# Erzeugen mit:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=please-generate-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Umgebung ---
# development | production
# In production verweigert der Server den Start mit dem Standard-SECRET_KEY.
ENVIRONMENT=development

# --- Frontend-Zugriff (CORS) ---
# Kommagetrennte Liste erlaubter Origins. In der Produktion die echte
# Frontend-Domain eintragen, z. B. https://mein-journal.netlify.app
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500

# --- KI (optional) ---
# Leer lassen = deterministische Texte ohne externen Anbieter.
AI_API_KEY=
